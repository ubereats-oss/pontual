rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(locationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/punchLocations/$(locationId)/members/$(request.auth.uid));
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid;
    }

    match /locationCodes/{code} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }

    match /punchLocations/{locationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if signedIn()
        && request.resource.data.adminUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids;
      allow update: if signedIn()
        && (
          resource.data.adminUid == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberUids', 'updatedAt'])
            && request.auth.uid in request.resource.data.memberUids
            && request.resource.data.memberUids.hasAll(resource.data.memberUids)
        );
      allow delete: if false;

      match /members/{uid} {
        allow read: if isMember(locationId);
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if false;
      }

      match /punches/{punchId} {
        allow read: if isMember(locationId);
        allow create: if isMember(locationId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.isMocked == false
          && request.resource.data.distanceMeters
            <= get(/databases/$(database)/documents/punchLocations/$(locationId)).data.allowedRadiusMeters;
        allow update, delete: if false;
      }

      match /blockedPunchAttempts/{attemptId} {
        allow read: if isMember(locationId);
        allow create: if isMember(locationId)
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
